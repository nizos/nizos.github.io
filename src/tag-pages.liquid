---
layout: layouts/base.liquid
permalink: /tags/{{ tag | slugify }}/
pagination:
  data: collections.tagList
  size: 1
  alias: "tag"
  addAllPagesToCollections: true
eleventyComputed:
  title: "Posts tagged #{{ tag }}"
  tag: "{{ tag }}"
---
<h1>{{ title }}</h1>
{% assign posts = collections.posts | filterByTag: tag %}
{% include "components/posts-list.liquid", titleTag: "h2" %}
