{%- comment %} titleTag lets the caller keep headings in order: h3 under a section
heading, h2 when the list sits directly under the page h1. {% endcomment %}
{%- assign titleTag = titleTag | default: 'h3' %}
<ul class="post-list">
    {% assign posts = posts %}
    {%- for post in posts reversed -%}
        <li class="post-list__item">
            <div class="post-list__meta">
                <time>{{ post.date | readableDate }}</time>
                <span> · </span>
                <span>{{ post.content | timeToRead }}</span>
            </div>

            <div class="post-list__row">
                <div class="post-list__body">
                    <a href="{{ post.url }}" class="post-list__link">
                        <{{ titleTag }} class="post-list__title">{{ post.data.title }}</{{ titleTag }}>
                    </a>

                    <p class="post-list__excerpt">{{ post.templateContent | strip_html | excerpt }}</p>

                    <div class="post-list__tags">
                        {% assign filteredTags = post.data.tags | postTags %}
                        {% for tag in filteredTags %}
                            {% capture tagUrl %}/tags/{{ tag }}/{% endcapture %}
                            <a href="{{ tagUrl | url }}">#{{ tag }}</a>
                        {% endfor %}
                    </div>
                </div>

                <a href="{{ post.url }}" class="post-list__thumb" aria-hidden="true" tabindex="-1">
                    {% if forloop.index <= 2 %}
                        {% image post.data.cover, post.data.coverAlt, "eager" %}
                    {% else %}
                        {% image post.data.cover, post.data.coverAlt, "lazy" %}
                    {% endif %}
                </a>
            </div>
        </li>
    {%- endfor -%}
</ul>
